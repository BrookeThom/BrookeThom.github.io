<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brooke Thompson | B.S. in Business Leadership and Management | Rutgers University</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        rutgers: {
                            red: '#CC0033',
                            darkred: '#990026',
                            black: '#000000',
                            gray: '#5f6062',
                            lightgray: '#f4f4f6'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom Glassmorphism Styles -->
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .dark .glass-panel {
            background: rgba(24, 24, 27, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .dark .glass-nav {
            background: rgba(18, 18, 20, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .rutgers-gradient {
            background: linear-gradient(135deg, #CC0033 0%, #7d001e 100%);
        }
        .rutgers-text-gradient {
            background: linear-gradient(135deg, #CC0033 0%, #e63956 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 dark:bg-zinc-900 dark:text-gray-100 font-sans transition-colors duration-300 min-h-screen flex flex-col antialiased selection:bg-rutgers-red selection:text-white">

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-40 w-full glass-nav border-b border-gray-200 dark:border-zinc-800 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand / Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg rutgers-gradient text-white font-bold text-xl flex items-center justify-center shadow-md shadow-rutgers-red/20">
                        R
                    </div>
                    <div>
                        <span id="nav-name" class="font-bold text-lg tracking-tight block text-gray-900 dark:text-white leading-none">Brooke Thompson</span>
                        <span id="nav-subtitle" class="text-xs text-rutgers-red dark:text-red-400 font-medium">Rutgers Business School</span>
                    </div>
                </div>

                <!-- Desktop Nav Links -->
                <div class="hidden md:flex items-center space-x-6 text-sm font-medium">
                    <a href="#about" class="hover:text-rutgers-red dark:hover:text-red-400 transition-colors">About</a>
                    <a href="#statement" class="hover:text-rutgers-red dark:hover:text-red-400 transition-colors">Statement</a>
                    <a href="#education" class="hover:text-rutgers-red dark:hover:text-red-400 transition-colors">Education & Resume</a>
                    <a href="#projects" class="hover:text-rutgers-red dark:hover:text-red-400 transition-colors">Projects</a>
                    <a href="#skills" class="hover:text-rutgers-red dark:hover:text-red-400 transition-colors">Skills</a>
                    <a href="#contact" class="hover:text-rutgers-red dark:hover:text-red-400 transition-colors">Contact</a>
                </div>

                <!-- Action Controls -->
                <div class="flex items-center space-x-3">
                    <!-- Dark/Light Mode Toggle -->
                    <button id="theme-toggle" class="p-2.5 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-zinc-800 focus:outline-none transition-colors" title="Toggle Dark/Light Mode">
                        <i id="theme-toggle-dark-icon" class="fa-solid font-900 fa-moon text-lg hidden"></i>
                        <i id="theme-toggle-light-icon" class="fa-solid fa-sun text-lg"></i>
                    </button>

                    <!-- Customize Drawer Toggle -->
                    <button id="open-customizer" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-rutgers-red text-white hover:bg-rutgers-darkred transition-all shadow-md shadow-rutgers-red/30">
                        <i class="fa-solid fa-sliders"></i>
                        <span>Edit Portfolio</span>
                    </button>

                    <!-- Mobile Menu Toggle -->
                    <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-zinc-800">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 px-4 pt-2 pb-4 space-y-2 text-sm font-medium">
            <a href="#about" class="mobile-link block py-2 hover:text-rutgers-red">About</a>
            <a href="#statement" class="mobile-link block py-2 hover:text-rutgers-red">Statement</a>
            <a href="#education" class="mobile-link block py-2 hover:text-rutgers-red">Education & Resume</a>
            <a href="#projects" class="mobile-link block py-2 hover:text-rutgers-red">Projects</a>
            <a href="#skills" class="mobile-link block py-2 hover:text-rutgers-red">Skills</a>
            <a href="#contact" class="mobile-link block py-2 hover:text-rutgers-red">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="about" class="relative pt-12 pb-20 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Left Details -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-red-100 text-rutgers-red dark:bg-red-950/60 dark:text-red-400 border border-red-200 dark:border-red-900/50">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span id="hero-badge">Rutgers University Class of May 2027</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-tight">
                        Hi, I'm <span id="hero-name" class="rutgers-text-gradient">Brooke Thompson</span>
                    </h1>

                    <h2 id="hero-degree" class="text-xl sm:text-2xl font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                        <i class="fa-solid fa-briefcase text-rutgers-red"></i>
                        <span>B.S. in Business Leadership and Management</span>
                    </h2>

                    <p id="hero-bio" class="text-base sm:text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
                        Passionate student at Rutgers Business School with a focus on business leadership, corporate strategy, team management, and organizational development. Preparing to lead future dynamic teams with strategic insight and purpose.
                    </p>

                    <!-- Contact/Social Buttons -->
                    <div class="flex flex-wrap items-center gap-4 pt-2">
                        <a href="#contact" class="px-6 py-3 rounded-xl bg-rutgers-red hover:bg-rutgers-darkred text-white font-semibold text-sm shadow-lg shadow-rutgers-red/30 hover:shadow-xl transition-all flex items-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>Get in Touch</span>
                        </a>
                        <button onclick="openResumeModal()" class="px-6 py-3 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-gray-200 dark:hover:bg-zinc-700 text-gray-900 dark:text-white font-semibold text-sm transition-all flex items-center gap-2 border border-gray-200 dark:border-zinc-700">
                            <i class="fa-solid fa-file-lines text-rutgers-red"></i>
                            <span>View Resume</span>
                        </button>
                        <a id="hero-linkedin" href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-gray-200 dark:hover:bg-zinc-700 text-gray-700 dark:text-gray-300 transition-colors" title="LinkedIn">
                            <i class="fa-brands fa-linkedin-in text-lg"></i>
                        </a>
                        <a id="hero-email-icon" href="mailto:brooke.thompson@rutgers.edu" class="p-3 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-gray-200 dark:hover:bg-zinc-700 text-gray-700 dark:text-gray-300 transition-colors" title="Email">
                            <i class="fa-solid fa-envelope text-lg"></i>
                        </a>
                    </div>
                </div>

                <!-- Right Card Graphic -->
                <div class="lg:col-span-5">
                    <div class="glass-panel p-8 rounded-3xl shadow-2xl relative border border-gray-200/80 dark:border-zinc-700/80">
                        <div class="absolute -top-4 -right-4 w-20 h-20 bg-rutgers-red/10 rounded-full blur-2xl"></div>
                        <div class="flex items-center space-x-4 mb-6">
                            <img id="profile-img" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=400" alt="Brooke Thompson" class="w-20 h-20 rounded-2xl object-cover shadow-md border-2 border-rutgers-red/30">
                            <div>
                                <h3 id="card-name" class="font-bold text-lg text-gray-900 dark:text-white">Brooke Thompson</h3>
                                <p id="card-major" class="text-xs text-rutgers-red dark:text-red-400 font-semibold">B.S. in Business Leadership and Management</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><i class="fa-solid fa-location-dot mr-1"></i>New Brunswick, NJ</p>
                            </div>
                        </div>

                        <!-- Key Stats / Focus -->
                        <div class="grid grid-cols-2 gap-3 pt-4 border-t border-gray-200 dark:border-zinc-800">
                            <div class="bg-gray-50 dark:bg-zinc-800/60 p-3 rounded-xl">
                                <span class="text-xs text-gray-500 dark:text-gray-400 block">University</span>
                                <span class="text-xs font-bold text-gray-800 dark:text-gray-200">Rutgers University</span>
                            </div>
                            <div class="bg-gray-50 dark:bg-zinc-800/60 p-3 rounded-xl">
                                <span class="text-xs text-gray-500 dark:text-gray-400 block">Graduation</span>
                                <span class="text-xs font-bold text-gray-800 dark:text-gray-200">Expected May 2027</span>
                            </div>
                            <div class="bg-gray-50 dark:bg-zinc-800/60 p-3 rounded-xl col-span-2">
                                <span class="text-xs text-gray-500 dark:text-gray-400 block">Academic Focus</span>
                                <span id="card-focus" class="text-xs font-bold text-gray-800 dark:text-gray-200">Business Leadership and Management</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Personal Statement Section -->
    <section id="statement" class="py-16 bg-white dark:bg-zinc-900/60 border-y border-gray-200/80 dark:border-zinc-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <span class="text-xs font-bold text-rutgers-red tracking-widest uppercase">Philosophy & Vision</span>
                <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white mt-1">Personal Statement</h2>
                <div class="w-12 h-1 bg-rutgers-red mx-auto mt-3 rounded-full"></div>
            </div>

            <div class="glass-panel p-8 sm:p-10 rounded-3xl relative shadow-xl border border-red-100 dark:border-zinc-800">
                <i class="fa-solid fa-quote-left text-4xl text-rutgers-red/20 absolute top-6 left-6"></i>
                <div class="relative z-10 pl-6 sm:pl-8">
                    <p id="display-statement" class="text-lg sm:text-xl text-gray-700 dark:text-gray-300 leading-relaxed font-normal italic">
                        "As a dedicated student pursuing a B.S. in Business Leadership and Management at Rutgers Business School, my goal is to blend analytical strategy with empathetic team leadership. I specialize in strategic decision-making, organizational development, corporate planning, and driving high-performance team culture. I believe sustainable corporate success stems from empowering individuals, cultivating agile leadership, and implementing robust strategic frameworks."
                    </p>
                    <div class="mt-6 flex items-center justify-between">
                        <div>
                            <h4 id="statement-author" class="font-bold text-gray-900 dark:text-white">Brooke Thompson</h4>
                            <p id="statement-title" class="text-xs text-rutgers-red font-medium">Business Leadership and Management Candidate</p>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-semibold px-3 py-1 bg-red-50 dark:bg-red-950/50 text-rutgers-red rounded-full">Rutgers Business School</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Education & Resume Hub -->
    <section id="education" class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-14">
                <span class="text-xs font-bold text-rutgers-red tracking-widest uppercase">Academic Foundation</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mt-1">Education & Resume Hub</h2>
                <p class="text-gray-600 dark:text-gray-400 max-w-xl mx-auto mt-2 text-sm">Explore my degree progress, tailored Business Leadership and Management coursework, and campus engagement.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                
                <!-- Degree Overview Card -->
                <div class="lg:col-span-5 space-y-6">
                    <div class="glass-panel p-8 rounded-3xl border border-gray-200/80 dark:border-zinc-800 shadow-lg">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-14 h-14 rounded-2xl rutgers-gradient flex items-center justify-center text-white text-2xl shadow-md">
                                <i class="fa-solid fa-university"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white">Rutgers University</h3>
                                <p class="text-sm font-semibold text-rutgers-red">Rutgers Business School</p>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div class="border-b border-gray-200 dark:border-zinc-800 pb-3">
                                <span class="text-xs text-gray-500 uppercase tracking-wider">Degree Program</span>
                                <p id="edu-degree" class="text-base font-bold text-gray-900 dark:text-white">B.S. in Business Leadership and Management</p>
                            </div>
                            <div class="border-b border-gray-200 dark:border-zinc-800 pb-3">
                                <span class="text-xs text-gray-500 uppercase tracking-wider">Expected Graduation</span>
                                <p class="text-base font-bold text-gray-900 dark:text-white">May 2027</p>
                            </div>
                            <div class="border-b border-gray-200 dark:border-zinc-800 pb-3">
                                <span class="text-xs text-gray-500 uppercase tracking-wider">Academic Honors</span>
                                <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Rutgers Business School Dean's List, Academic Excellence Scholar</p>
                            </div>
                        </div>

                        <!-- Resume Modal Trigger -->
                        <div class="mt-8 pt-4 flex flex-col sm:flex-row gap-3">
                            <button onclick="openResumeModal()" class="w-full py-3 px-4 rounded-xl bg-rutgers-red hover:bg-rutgers-darkred text-white font-semibold text-sm transition-all shadow-md flex items-center justify-center gap-2">
                                <i class="fa-solid fa-eye"></i>
                                <span>Preview Resume</span>
                            </button>
                            <a id="download-resume-btn" href="#" onclick="downloadPDFResume(event)" class="w-full py-3 px-4 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-gray-200 dark:hover:bg-zinc-700 text-gray-900 dark:text-white font-semibold text-sm transition-all flex items-center justify-center gap-2 border border-gray-200 dark:border-zinc-700">
                                <i class="fa-solid fa-download text-rutgers-red"></i>
                                <span>Download PDF</span>
                            </a>
                        </div>
                    </div>

                    <!-- Leadership & Campus Organizations -->
                    <div class="glass-panel p-8 rounded-3xl border border-gray-200/80 dark:border-zinc-800 shadow-lg">
                        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-users-gear text-rutgers-red"></i>
                            <span>Campus Leadership & Involvement</span>
                        </h4>

                        <div class="space-y-4">
                            <div class="flex items-start gap-3">
                                <div class="w-2 h-2 rounded-full bg-rutgers-red mt-2"></div>
                                <div>
                                    <h5 class="font-bold text-sm text-gray-900 dark:text-white">Rutgers Business Governing Association (RBGA)</h5>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">Student Affairs Committee Chair • Organizing collegiate leadership summits</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="w-2 h-2 rounded-full bg-rutgers-red mt-2"></div>
                                <div>
                                    <h5 class="font-bold text-sm text-gray-900 dark:text-white">Future Business Leaders of America (FBLA)</h5>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">VP of Organizational Development • Mentoring underclassmen leadership</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="w-2 h-2 rounded-full bg-rutgers-red mt-2"></div>
                                <div>
                                    <h5 class="font-bold text-sm text-gray-900 dark:text-white">Rutgers Management Club</h5>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">Executive Team Lead • Organizing corporate speaker series & case workshops</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coursework Matrix Card -->
                <div class="lg:col-span-7">
                    <div class="glass-panel p-8 rounded-3xl border border-gray-200/80 dark:border-zinc-800 shadow-lg h-full flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                    <i class="fa-solid fa-book-open text-rutgers-red"></i>
                                    <span>Specialized Coursework</span>
                                </h3>
                                <span class="text-xs font-semibold px-3 py-1 bg-red-100 dark:bg-red-950/60 text-rutgers-red dark:text-red-400 rounded-full">
                                    Business Leadership and Management Focus
                                </span>
                            </div>

                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
                                Advanced coursework completed at Rutgers Business School tailored specifically toward organizational management, strategic decision-making, and executive leadership:
                            </p>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="p-4 rounded-2xl bg-white dark:bg-zinc-800/80 border border-gray-200 dark:border-zinc-700/60 shadow-sm">
                                    <div class="text-xs font-bold text-rutgers-red">33:620:301</div>
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white mt-0.5">Organizational Behavior</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Study of individual/group dynamics, team motivation, culture, and leadership dynamics.</p>
                                </div>

                                <div class="p-4 rounded-2xl bg-white dark:bg-zinc-800/80 border border-gray-200 dark:border-zinc-700/60 shadow-sm">
                                    <div class="text-xs font-bold text-rutgers-red">33:620:490</div>
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white mt-0.5">Strategic Management</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Cap-stone evaluation of competitive strategies, corporate expansion, and market positioning.</p>
                                </div>

                                <div class="p-4 rounded-2xl bg-white dark:bg-zinc-800/80 border border-gray-200 dark:border-zinc-700/60 shadow-sm">
                                    <div class="text-xs font-bold text-rutgers-red">33:620:365</div>
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white mt-0.5">Managerial Leadership</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Developing personal executive style, negotiation strategies, and influence tactics.</p>
                                </div>

                                <div class="p-4 rounded-2xl bg-white dark:bg-zinc-800/80 border border-gray-200 dark:border-zinc-700/60 shadow-sm">
                                    <div class="text-xs font-bold text-rutgers-red">33:620:300</div>
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white mt-0.5">Principles of Management</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Core fundamentals of corporate planning, organizing, leading, and controlling.</p>
                                </div>

                                <div class="p-4 rounded-2xl bg-white dark:bg-zinc-800/80 border border-gray-200 dark:border-zinc-700/60 shadow-sm">
                                    <div class="text-xs font-bold text-rutgers-red">33:390:300</div>
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white mt-0.5">Corporate Finance</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Financial evaluation, capital budgeting, risk assessment, and decision modeling.</p>
                                </div>

                                <div class="p-4 rounded-2xl bg-white dark:bg-zinc-800/80 border border-gray-200 dark:border-zinc-700/60 shadow-sm">
                                    <div class="text-xs font-bold text-rutgers-red">33:140:320</div>
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white mt-0.5">Business Communication</h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Executive presentations, stakeholder communication, and conflict resolution tactics.</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 pt-4 border-t border-gray-200 dark:border-zinc-800 text-center">
                            <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">
                                <i class="fa-solid fa-certificate text-rutgers-red mr-1"></i> Specialization Track: B.S. in Business Leadership and Management
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-20 bg-gray-100/60 dark:bg-zinc-900/40 border-y border-gray-200/80 dark:border-zinc-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-14">
                <span class="text-xs font-bold text-rutgers-red tracking-widest uppercase">Practical Execution</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mt-1">Featured Leadership Projects</h2>
                <p class="text-gray-600 dark:text-gray-400 max-w-xl mx-auto mt-2 text-sm">Strategic initiatives, case competition victories, and managerial analyses.</p>
            </div>

            <!-- Dynamic Projects Grid -->
            <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Projects injected by JavaScript -->
            </div>
        </div>
    </section>

    <!-- Skills Matrix Section -->
    <section id="skills" class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-14">
                <span class="text-xs font-bold text-rutgers-red tracking-widest uppercase">Competency Overview</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mt-1">Leadership & Management Skills</h2>
                <p class="text-gray-600 dark:text-gray-400 max-w-xl mx-auto mt-2 text-sm">Interactive skill matrix tailored to core business leadership competencies.</p>
            </div>

            <!-- Filter Categories -->
            <div id="skills-filter" class="flex flex-wrap items-center justify-center gap-2 mb-10">
                <!-- Dynamically populated skills filter tags -->
            </div>

            <!-- Skills Display Container -->
            <div id="skills-container" class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
                <!-- Dynamically populated interactive skill tags -->
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 bg-white dark:bg-zinc-900/80 border-t border-gray-200/80 dark:border-zinc-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-gray-200 dark:border-zinc-800 shadow-2xl">
                <div class="text-center mb-8">
                    <span class="text-xs font-bold text-rutgers-red tracking-widest uppercase">Connect</span>
                    <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white mt-1">Let's Connect</h2>
                    <p class="text-gray-600 dark:text-gray-400 text-sm mt-2">Interested in discussing strategy, business leadership opportunities, or collaborative projects?</p>
                </div>

                <form id="contact-form" onsubmit="handleContactSubmit(event)" class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Your Name</label>
                            <input type="text" required placeholder="e.g. Jane Doe" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-rutgers-red text-sm transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Your Email</label>
                            <input type="email" required placeholder="e.g. jane@example.com" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-rutgers-red text-sm transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Subject</label>
                        <input type="text" required placeholder="Business Leadership Opportunity" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-rutgers-red text-sm transition-all">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-2">Message</label>
                        <textarea rows="4" required placeholder="Hello Brooke, I would love to connect regarding..." class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-rutgers-red text-sm transition-all"></textarea>
                    </div>

                    <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-rutgers-red hover:bg-rutgers-darkred text-white font-bold text-sm shadow-lg shadow-rutgers-red/30 hover:shadow-xl transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Send Message</span>
                    </button>
                </form>

                <div id="contact-feedback" class="hidden mt-4 p-4 rounded-xl bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300 text-center text-sm font-semibold">
                    Thank you for your message! Brooke will get back to you shortly.
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="mt-auto py-8 bg-zinc-900 text-gray-400 border-t border-zinc-800 text-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:flex sm:justify-between sm:items-center">
            <p>© <span id="footer-year">2026</span> <span id="footer-name">Brooke Thompson</span>. B.S. in Business Leadership and Management | Rutgers University.</p>
            <div class="flex justify-center space-x-4 mt-4 sm:mt-0">
                <a href="https://linkedin.com" target="_blank" class="hover:text-white transition-colors"><i class="fa-brands fa-linkedin text-base"></i></a>
                <a href="mailto:brooke.thompson@rutgers.edu" class="hover:text-white transition-colors"><i class="fa-solid fa-envelope text-base"></i></a>
            </div>
        </div>
    </footer>

    <!-- Resume Preview Modal -->
    <div id="resume-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="glass-panel bg-white dark:bg-zinc-900 rounded-3xl w-full max-w-3xl max-h-[90vh] overflow-y-auto border border-gray-200 dark:border-zinc-700 p-6 sm:p-8 relative shadow-2xl">
            <button onclick="closeResumeModal()" class="absolute top-5 right-5 text-gray-500 hover:text-gray-900 dark:hover:text-white p-2 text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Modal Resume Header -->
            <div class="border-b border-gray-200 dark:border-zinc-800 pb-6 mb-6">
                <h2 id="modal-resume-name" class="text-2xl font-bold text-gray-900 dark:text-white">Brooke Thompson</h2>
                <p id="modal-resume-major" class="text-rutgers-red font-semibold text-sm">B.S. in Business Leadership and Management</p>
                <p class="text-xs text-gray-500 mt-1">Rutgers University, Rutgers Business School • Expected Graduation: May 2027</p>
                <p class="text-xs text-gray-500">Email: brooke.thompson@rutgers.edu • Location: New Brunswick, NJ</p>
            </div>

            <!-- Resume Content Body -->
            <div class="space-y-6 text-sm">
                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white uppercase text-xs tracking-wider border-b border-rutgers-red/30 pb-1 mb-2">Executive Profile</h3>
                    <p id="modal-resume-statement" class="text-gray-600 dark:text-gray-300 text-xs leading-relaxed">
                        High-achieving student candidate pursuing a B.S. in Business Leadership and Management. Demonstrated expertise in team motivation, corporate strategic alignment, negotiation, and decision analysis through academic projects and campus leadership.
                    </p>
                </div>

                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white uppercase text-xs tracking-wider border-b border-rutgers-red/30 pb-1 mb-2">Education</h3>
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-bold text-gray-900 dark:text-white text-xs">Rutgers University - New Brunswick</h4>
                            <p class="text-xs text-rutgers-red">B.S. in Business Leadership and Management, Rutgers Business School</p>
                        </div>
                        <span class="text-xs text-gray-500">Expected May 2027</span>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white uppercase text-xs tracking-wider border-b border-rutgers-red/30 pb-1 mb-2">Key Business Leadership Projects</h3>
                    <div class="space-y-3">
                        <div>
                            <h4 class="font-semibold text-xs text-gray-900 dark:text-white">Rutgers Business Case Competition Champion</h4>
                            <p class="text-xs text-gray-600 dark:text-gray-400">Led a 4-person team to devise a corporate turnaround strategy, analyzing market entry metrics and leadership restructuring.</p>
                        </div>
                        <div>
                            <h4 class="font-semibold text-xs text-gray-900 dark:text-white">Strategic Organizational Redesign Project</h4>
                            <p class="text-xs text-gray-600 dark:text-gray-400">Executed complete organizational restructuring model for a mid-market enterprise, introducing agile cross-functional managerial hierarchies.</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white uppercase text-xs tracking-wider border-b border-rutgers-red/30 pb-1 mb-2">Core Competencies</h3>
                    <p class="text-xs text-gray-600 dark:text-gray-400">Business Leadership, Strategic Planning, Organizational Behavior, Financial Analysis, Team Motivation, Conflict Negotiation, Public Speaking, Agile Management.</p>
                </div>
            </div>

            <div class="mt-8 pt-4 border-t border-gray-200 dark:border-zinc-800 flex justify-end gap-3">
                <button onclick="closeResumeModal()" class="px-4 py-2 rounded-xl bg-gray-200 dark:bg-zinc-800 text-gray-800 dark:text-gray-200 text-xs font-semibold">Close</button>
                <button onclick="downloadPDFResume(event)" class="px-4 py-2 rounded-xl bg-rutgers-red hover:bg-rutgers-darkred text-white text-xs font-semibold flex items-center gap-2">
                    <i class="fa-solid fa-download"></i> Download Resume
                </button>
            </div>
        </div>
    </div>

    <!-- Customizer Drawer Sidebar -->
    <div id="customizer-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white dark:bg-zinc-900 shadow-2xl border-l border-gray-200 dark:border-zinc-800 transform translate-x-full transition-transform duration-300 overflow-y-auto">
        <div class="p-6">
            <div class="flex items-center justify-between border-b border-gray-200 dark:border-zinc-800 pb-4 mb-6">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-rutgers-red text-xl"></i>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Live Portfolio Editor</h3>
                </div>
                <button id="close-customizer" class="text-gray-500 hover:text-gray-900 dark:hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <form id="customizer-form" class="space-y-5">
                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Student Name</label>
                    <input type="text" id="edit-name" class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Degree Major</label>
                    <input type="text" id="edit-major" class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 text-sm font-semibold text-rutgers-red">
                    <p class="text-[10px] text-gray-500 mt-1">Default value: Business Leadership and Management</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Graduation Year & Term</label>
                    <input type="text" id="edit-grad" class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Personal Statement</label>
                    <textarea id="edit-statement" rows="4" class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 text-sm"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase mb-1">Hero Bio</label>
                    <textarea id="edit-bio" rows="3" class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 text-sm"></textarea>
                </div>

                <div class="pt-4 border-t border-gray-200 dark:border-zinc-800 flex flex-col gap-3">
                    <button type="button" onclick="applyCustomizations()" class="w-full py-3 rounded-xl bg-rutgers-red text-white font-bold text-sm hover:bg-rutgers-darkred transition-colors shadow-md">
                        Apply Changes
                    </button>
                    <button type="button" onclick="exportHTMLFile()" class="w-full py-3 rounded-xl bg-zinc-800 dark:bg-zinc-700 text-white font-bold text-sm hover:bg-zinc-700 transition-colors flex items-center justify-center gap-2">
                        <i class="fa-solid fa-file-export"></i>
                        <span>Export Standalone Webpage</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Interactive Application Logic -->
    <script>
        // STRICT DEFAULT DATA CONFIGURATION
        const portfolioData = {
            name: "Brooke Thompson",
            major: "Business Leadership and Management",
            degreeFull: "B.S. in Business Leadership and Management",
            school: "Rutgers Business School",
            gradDate: "May 2027",
            email: "brooke.thompson@rutgers.edu",
            statement: "As a dedicated student pursuing a B.S. in Business Leadership and Management at Rutgers Business School, my goal is to blend analytical strategy with empathetic team leadership. I specialize in strategic decision-making, organizational development, corporate planning, and driving high-performance team culture. I believe sustainable corporate success stems from empowering individuals, cultivating agile leadership, and implementing robust strategic frameworks.",
            bio: "Passionate student at Rutgers Business School with a focus on business leadership, corporate strategy, team management, and organizational development. Preparing to lead future dynamic teams with strategic insight and purpose.",
            projects: [
                {
                    title: "Rutgers Business Case Competition Champion",
                    category: "Case Competition",
                    description: "Led a 4-person Business Leadership team to 1st place across 20 university teams, formulating an international market expansion strategy and organizational restructuring roadmap.",
                    skills: ["Strategic Planning", "Public Speaking", "Financial Analysis"]
                },
                {
                    title: "Strategic Organizational Redesign Project",
                    category: "Corporate Strategy",
                    description: "Evaluated a mid-sized firm's corporate management matrix. Designed an agile organizational structure improving inter-departmental communication efficiency by 30%.",
                    skills: ["Business Leadership", "Agile Management", "Negotiation"]
                },
                {
                    title: "Leadership & Team Motivation Workshop",
                    category: "Management Workshop",
                    description: "Designed and facilitated an interactive leadership development program for 60+ undergraduate students covering transformational leadership techniques.",
                    skills: ["Team Motivation", "Business Leadership", "Public Speaking"]
                }
            ],
            skills: [
                { name: "Business Leadership", category: "Leadership" },
                { name: "Management", category: "Leadership" },
                { name: "Strategic Planning", category: "Strategy" },
                { name: "Financial Analysis", category: "Finance" },
                { name: "Team Motivation", category: "Leadership" },
                { name: "Negotiation", category: "Management" },
                { name: "Public Speaking", category: "Communication" },
                { name: "Agile Management", category: "Management" }
            ]
        };

        document.addEventListener('DOMContentLoaded', () => {
            initTheme();
            renderProjects();
            renderSkills();
            populateCustomizerInputs();
            setupEventListeners();
        });

        // Theme Toggle Functionality
        function initTheme() {
            const themeToggleBtn = document.getElementById('theme-toggle');
            const darkIcon = document.getElementById('theme-toggle-dark-icon');
            const lightIcon = document.getElementById('theme-toggle-light-icon');

            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark');
                darkIcon.classList.remove('hidden');
                lightIcon.classList.add('hidden');
            } else {
                document.documentElement.classList.remove('dark');
                darkIcon.classList.add('hidden');
                lightIcon.classList.remove('hidden');
            }

            themeToggleBtn.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
                darkIcon.classList.toggle('hidden');
                lightIcon.classList.toggle('hidden');
            });
        }

        // Render Projects Dynamic Grid
        function renderProjects() {
            const grid = document.getElementById('projects-grid');
            grid.innerHTML = portfolioData.projects.map(p => `
                <div class="glass-panel p-6 rounded-3xl border border-gray-200 dark:border-zinc-800 flex flex-col justify-between hover:shadow-xl transition-all">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold text-rutgers-red uppercase tracking-wider">${p.category}</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-gray-400"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">${p.title}</h3>
                        <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed mb-4">${p.description}</p>
                    </div>
                    <div class="flex flex-wrap gap-1.5 pt-3 border-t border-gray-100 dark:border-zinc-800">
                        ${p.skills.map(s => `<span class="px-2.5 py-1 text-[10px] font-semibold bg-red-50 text-rutgers-red dark:bg-red-950/40 dark:text-red-300 rounded-md">${s}</span>`).join('')}
                    </div>
                </div>
            `).join('');
        }

        // Render Interactive Skills Matrix
        function renderSkills() {
            const container = document.getElementById('skills-container');
            const filterContainer = document.getElementById('skills-filter');

            const categories = ["All", ...new Set(portfolioData.skills.map(s => s.category))];

            filterContainer.innerHTML = categories.map((c, idx) => `
                <button onclick="filterSkills('${c}')" class="skill-filter-btn px-3 py-1.5 rounded-full text-xs font-semibold ${idx === 0 ? 'bg-rutgers-red text-white' : 'bg-gray-200 dark:bg-zinc-800 text-gray-700 dark:text-gray-300'} transition-all">
                    ${c}
                </button>
            `).join('');

            displaySkills(portfolioData.skills);
        }

        function displaySkills(skillsList) {
            const container = document.getElementById('skills-container');
            container.innerHTML = skillsList.map(s => `
                <div class="px-4 py-2.5 rounded-xl bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700/80 text-sm font-semibold text-gray-800 dark:text-gray-200 shadow-sm flex items-center gap-2 hover:border-rutgers-red transition-all cursor-default">
                    <i class="fa-solid fa-check text-rutgers-red text-xs"></i>
                    <span>${s.name}</span>
                </div>
            `).join('');
        }

        function filterSkills(category) {
            document.querySelectorAll('.skill-filter-btn').forEach(btn => {
                if(btn.textContent.trim() === category) {
                    btn.className = "skill-filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-rutgers-red text-white transition-all";
                } else {
                    btn.className = "skill-filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-200 dark:bg-zinc-800 text-gray-700 dark:text-gray-300 transition-all";
                }
            });

            if (category === "All") {
                displaySkills(portfolioData.skills);
            } else {
                displaySkills(portfolioData.skills.filter(s => s.category === category));
            }
        }

        // Customizer Drawer Handling
        function setupEventListeners() {
            const customizer = document.getElementById('customizer-drawer');
            document.getElementById('open-customizer').addEventListener('click', () => customizer.classList.remove('translate-x-full'));
            document.getElementById('close-customizer').addEventListener('click', () => customizer.classList.add('translate-x-full'));

            // Mobile Menu
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            mobileBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
            document.querySelectorAll('.mobile-link').forEach(l => l.addEventListener('click', () => mobileMenu.classList.add('hidden')));
        }

        function populateCustomizerInputs() {
            document.getElementById('edit-name').value = portfolioData.name;
            document.getElementById('edit-major').value = portfolioData.major;
            document.getElementById('edit-grad').value = portfolioData.gradDate;
            document.getElementById('edit-statement').value = portfolioData.statement;
            document.getElementById('edit-bio').value = portfolioData.bio;
        }

        function applyCustomizations() {
            const newName = document.getElementById('edit-name').value;
            const newMajor = document.getElementById('edit-major').value;
            const newGrad = document.getElementById('edit-grad').value;
            const newStatement = document.getElementById('edit-statement').value;
            const newBio = document.getElementById('edit-bio').value;

            // Apply updates across elements
            document.getElementById('nav-name').textContent = newName;
            document.getElementById('hero-name').textContent = newName;
            document.getElementById('card-name').textContent = newName;
            document.getElementById('statement-author').textContent = newName;
            document.getElementById('modal-resume-name').textContent = newName;
            document.getElementById('footer-name').textContent = newName;

            document.getElementById('hero-degree').querySelector('span').textContent = "B.S. in " + newMajor;
            document.getElementById('card-major').textContent = "B.S. in " + newMajor;
            document.getElementById('card-focus').textContent = newMajor;
            document.getElementById('edu-degree').textContent = "B.S. in " + newMajor;
            document.getElementById('statement-title').textContent = newMajor + " Candidate";
            document.getElementById('modal-resume-major').textContent = "B.S. in " + newMajor;

            document.getElementById('display-statement').textContent = `"${newStatement}"`;
            document.getElementById('hero-bio').textContent = newBio;
            document.getElementById('hero-badge').textContent = `Rutgers University Class of ${newGrad}`;

            document.getElementById('customizer-drawer').classList.add('translate-x-full');
        }

        // Resume Preview Modal Logic
        function openResumeModal() {
            document.getElementById('resume-modal').classList.remove('hidden');
        }

        function closeResumeModal() {
            document.getElementById('resume-modal').classList.add('hidden');
        }

        function downloadPDFResume(e) {
            e.preventDefault();
            const textContent = `
RESUME: ${portfolioData.name}
DEGREE: ${portfolioData.degreeFull}
UNIVERSITY: ${portfolioData.school}, Rutgers University
GRADUATION: ${portfolioData.gradDate}

PERSONAL STATEMENT:
${portfolioData.statement}

SPECIALIZED COURSEWORK (BUSINESS LEADERSHIP AND MANAGEMENT):
- Organizational Behavior (33:620:301)
- Strategic Management (33:620:490)
- Managerial Leadership (33:620:365)
- Principles of Management (33:620:300)
- Corporate Finance (33:390:300)
- Business Communication (33:140:320)

CORE SKILLS:
Business Leadership, Management, Strategic Planning, Financial Analysis, Team Motivation, Negotiation, Public Speaking, Agile Management.
            `;

            const blob = new Blob([textContent], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${portfolioData.name.replace(' ', '_')}_Resume_Business_Leadership.txt`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Contact Form Handling
        function handleContactSubmit(e) {
            e.preventDefault();
            const feedback = document.getElementById('contact-feedback');
            feedback.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => {
                feedback.classList.add('hidden');
            }, 5000);
        }

        // Export Standalone HTML file
        function exportHTMLFile() {
            const pageHTML = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
            const blob = new Blob([pageHTML], { type: 'text/html' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Brooke_Thompson_Business_Leadership_Portfolio.html`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
</body>
</html>
